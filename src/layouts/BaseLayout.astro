---
import '../styles/global.css';
import { sitePath } from '../lib/urls';

const { title, description, ogImage, author, noindex } = Astro.props;
const pageTitle = title || 'eScience Center Blog';
const pageDescription = description || 'eScience Center Blog — Research software engineering, data science, and digital scholarship';
const fallbackDescription = description || 'Research software engineering, data science, and digital scholarship';
const absoluteUrl = (path: string) => new URL(path, Astro.site || Astro.url).toString();
const imageUrl = absoluteUrl(ogImage || sitePath('/header-banner.webp'));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  {author && <meta name="author" content={author} />}
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={Astro.url.href} />
  <link rel="icon" type="image/png" href={sitePath("/favicon.png")} />
  <link rel="alternate" type="application/rss+xml" title="eScience Center Blog" href={sitePath("/rss.xml")} />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={fallbackDescription} />
  <meta property="og:type" content={title ? 'article' : 'website'} />
  <meta property="og:site_name" content="eScience Center Blog" />
  <meta property="og:url" content={Astro.url.href} />
  {author && <meta property="article:author" content={author} />}
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={fallbackDescription} />
  <meta name="twitter:image" content={imageUrl} />
  <title>{title ? `${title} — eScience Center Blog` : 'eScience Center Blog'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
  <!-- Prevent FOUC on dark mode -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <!-- Matomo -->
  <script is:inline>
    var _paq = window._paq = window._paq || [];
    /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
    _paq.push(['disableCookies']);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
      var u = '//matomo.research.software/';
      _paq.push(['setTrackerUrl', u + 'matomo.php']);
      _paq.push(['setSiteId', '11']);
      var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
      g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
    })();
  </script>
  <!-- End Matomo Code -->
</head>
<body class="min-h-screen flex flex-col bg-white text-[#242424] dark:bg-[#111] dark:text-[#e5e5e5] transition-colors">
  <!-- Minimal header — Medium style -->
  <header class="border-b border-[#f2f2f2] dark:border-[#333] sticky top-0 bg-white/95 dark:bg-[#111]/95 backdrop-blur-sm z-50">
    <div class="max-w-[960px] mx-auto px-4 h-14 flex items-center justify-between gap-3">
      <a href={sitePath("/")} class="flex items-center gap-2.5 no-underline min-w-0">
        <img src={sitePath("/favicon.png")} alt="" class="w-8 h-8 rounded-full flex-shrink-0" />
        <span class="font-semibold text-[15px] text-[#242424] dark:text-white tracking-tight truncate">eScience Center Blog</span>
      </a>
      <div class="flex items-center gap-3 sm:gap-5 flex-shrink-0">
        <button id="theme-toggle" class="inline-flex h-8 w-8 items-center justify-center rounded-full text-[#6b6b6b] hover:bg-[#f7f7f7] hover:text-[#242424] dark:text-[#aaa] dark:hover:bg-[#1f1f1f] dark:hover:text-white transition-colors cursor-pointer" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="h-4 w-4 dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.35 15.35A8.5 8.5 0 0 1 8.65 3.65 7 7 0 1 0 20.35 15.35Z" />
          </svg>
          <svg class="hidden h-4 w-4 dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
        <a href={sitePath("/topics")} class="text-[13px] text-[#6b6b6b] hover:text-[#242424] dark:text-[#aaa] dark:hover:text-white transition-colors hidden sm:inline">Topics</a>
        <button data-search-open class="text-[13px] text-[#6b6b6b] hover:text-[#242424] dark:text-[#aaa] dark:hover:text-white transition-colors cursor-pointer">Search</button>
        <a href="https://www.esciencecenter.nl" class="text-[13px] text-[#6b6b6b] hover:text-[#242424] dark:text-[#aaa] dark:hover:text-white transition-colors hidden sm:inline">esciencecenter.nl</a>
      </div>
    </div>
  </header>

  <main class="flex-1 animate-page">
    <slot />
  </main>

  <dialog id="search-modal" class="search-modal" aria-labelledby="search-modal-title">
    <div class="search-panel">
      <div class="search-panel-header">
        <div>
          <p class="search-eyebrow">Search the archive</p>
          <h2 id="search-modal-title">Find posts instantly</h2>
        </div>
        <button class="search-close" data-search-close aria-label="Close search">×</button>
      </div>
      <label class="search-input-wrap">
        <span class="sr-only">Search articles</span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10.5 4a6.5 6.5 0 0 1 5.16 10.45l4.45 4.44-1.42 1.42-4.44-4.45A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"/></svg>
        <input id="search-input" type="search" autocomplete="off" placeholder="Try “machine learning”, “Julia”, or an author…" />
      </label>
      <div class="search-meta"><span id="search-count">Start typing to search the archive</span><kbd>Esc</kbd></div>
      <div id="search-results" class="search-results" role="listbox" aria-label="Search results"></div>
    </div>
  </dialog>

  <!-- Minimal footer -->
  <footer class="border-t border-[#f2f2f2] dark:border-[#333] mt-12">
    <div class="max-w-[728px] mx-auto px-4 py-8 text-center text-[13px] text-[#6b6b6b] dark:text-[#999]">
      Netherlands eScience Center ·{' '}
      <a href="https://www.esciencecenter.nl" class="hover:text-[#242424] dark:hover:text-white transition-colors">Website</a>
      {' · '}
      <a href="https://blog.esciencecenter.nl" class="hover:text-[#242424] dark:hover:text-white transition-colors">Medium</a>
    </div>
  </footer>

  <script define:vars={{ searchIndexUrl: sitePath('/search-index.json'), searchPath: sitePath('/search') }}>
    const toggle = document.getElementById('theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const html = document.documentElement;
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
      });
    }

    (() => {
      const captionPattern = /^(Image source|Image credit|Photo credit|Photo by|Source:|Figure\s+\d+[:.]?)/i;
      document.querySelectorAll('.post-content p').forEach((imageParagraph) => {
        const nonWhitespaceNodes = Array.from(imageParagraph.childNodes).filter((node) => node.textContent?.trim() || node.nodeType !== Node.TEXT_NODE);
        if (nonWhitespaceNodes.length !== 1 || !(nonWhitespaceNodes[0] instanceof HTMLImageElement)) return;

        const next = imageParagraph.nextElementSibling;
        const figure = document.createElement('figure');
        figure.appendChild(nonWhitespaceNodes[0]);
        imageParagraph.replaceWith(figure);

        if (!(next instanceof HTMLParagraphElement) || !captionPattern.test((next.textContent || '').trim())) return;
        const caption = document.createElement('figcaption');
        while (next.firstChild) caption.appendChild(next.firstChild);
        figure.appendChild(caption);
        next.remove();
      });
    })();


    (() => {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      const count = document.getElementById('search-count');
      if (!modal || !input || !results || !count) return;

      let posts = [];
      let loadingPromise = null;
      async function loadSearchIndex() {
        if (posts.length) return posts;
        if (!loadingPromise) {
          count.textContent = 'Loading search index…';
          results.innerHTML = '';
          loadingPromise = fetch(searchIndexUrl)
            .then((response) => {
              if (!response.ok) throw new Error(`Search index failed: ${response.status}`);
              return response.json();
            })
            .then((data) => {
              posts = Array.isArray(data) ? data : [];
              return posts;
            })
            .catch((error) => {
              console.error(error);
              count.textContent = 'Search is unavailable';
              results.innerHTML = '<div class="search-empty">Could not load the search index. Please refresh and try again.</div>';
              return [];
            });
        }
        return loadingPromise;
      }
      const normalize = (value) => String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const escapeHtml = (value) => String(value || '').replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[char]));

      function render(query = '') {
        const q = normalize(query.trim());
        if (!q) {
          count.textContent = `Start typing to search ${posts.length} posts`;
          results.innerHTML = posts.slice(0, 6).map(renderPost).join('');
          return;
        }
        const words = q.split(/\s+/).filter(Boolean);
        const matches = posts
          .map((post) => {
            const haystack = normalize([post.title, post.author, post.date, post.tags?.join(' '), post.excerpt].join(' '));
            if (!words.every((word) => haystack.includes(word))) return null;
            let score = 0;
            const title = normalize(post.title);
            const author = normalize(post.author);
            if (title.includes(q)) score += 6;
            if (author.includes(q)) score += 3;
            if (post.tags?.some((tag) => normalize(tag).includes(q))) score += 2;
            score += words.reduce((sum, word) => sum + (title.includes(word) ? 2 : 0), 0);
            return { ...post, score };
          })
          .filter(Boolean)
          .sort((a, b) => b.score - a.score)
          .slice(0, 10);
        count.textContent = matches.length ? `${matches.length} result${matches.length === 1 ? '' : 's'}` : 'No matches';
        results.innerHTML = matches.length
          ? matches.map(renderPost).join('')
          : `<div class="search-empty">No posts found. Try a broader term or author name.</div>`;
      }

      function renderPost(post) {
        const tags = (post.tags || []).slice(0, 3).map((tag) => `<span>${escapeHtml(tag)}</span>`).join('');
        return `
          <a class="search-result" href="${post.url}" role="option">
            <span class="search-result-title">${escapeHtml(post.title)}</span>
            <span class="search-result-meta">${escapeHtml(post.author)} · ${escapeHtml(post.date)}</span>
            <span class="search-result-excerpt">${escapeHtml(post.excerpt)}</span>
            ${tags ? `<span class="search-result-tags">${tags}</span>` : ''}
          </a>`;
      }

      async function openSearch(value = '') {
        if (typeof modal.showModal === 'function') modal.showModal();
        else modal.setAttribute('open', '');
        document.body.classList.add('search-open');
        input.value = value;
        await loadSearchIndex();
        render(value);
        setTimeout(() => input.focus(), 30);
      }

      function closeSearch() {
        if (typeof modal.close === 'function') modal.close();
        else modal.removeAttribute('open');
        document.body.classList.remove('search-open');
      }

      document.querySelectorAll('[data-search-open], a[href$="/search"], a[href*="/search?"]').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          const url = trigger instanceof HTMLAnchorElement ? new URL(trigger.href) : null;
          openSearch(url?.searchParams.get('q') || '');
        });
      });
      document.querySelectorAll('[data-search-close]').forEach((trigger) => trigger.addEventListener('click', closeSearch));
      modal.addEventListener('click', (event) => {
        if (event.target === modal) closeSearch();
      });
      input.addEventListener('input', () => render(input.value));
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          openSearch();
        }
      });

      const current = new URL(window.location.href);
      if (current.pathname === new URL(searchPath, window.location.origin).pathname) openSearch(current.searchParams.get('q') || '');
    })();
  </script>

  <script>
    import mermaid from 'mermaid';

    async function initMermaidBlocks() {
      const blocks = Array.from(document.querySelectorAll('pre[data-language="mermaid"] > code, pre > code.language-mermaid, code.language-mermaid'));
      if (!blocks.length) return;

      mermaid.initialize({
        startOnLoad: false,
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
        securityLevel: 'strict',
      });

      blocks.forEach((code, index) => {
        const pre = code.closest('pre');
        const source = code.textContent || '';
        const container = document.createElement('div');
        container.className = 'mermaid-diagram';
        container.textContent = source;
        container.id = `mermaid-${index}`;
        if (pre) pre.replaceWith(container);
        else code.replaceWith(container);
      });

      await mermaid.run({ nodes: document.querySelectorAll('.mermaid-diagram') });
    }

    initMermaidBlocks().catch((error) => console.error('Mermaid rendering failed', error));
  </script>
</body>
</html>
