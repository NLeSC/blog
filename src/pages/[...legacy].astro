---
import { getCollection } from 'astro:content';
import redirects from '../legacy-redirects.json';
import { postSlug, postSourceSlug } from '../lib/archive';
import { sitePath } from '../lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const renamedPosts = posts.flatMap((post) => post.data.slug
    ? [postSourceSlug(post), postSourceSlug(post).replace(/\s+-\s+/g, '---')].map((source) => ({
        params: { legacy: `posts/${source}` },
        props: { target: `/posts/${postSlug(post)}` },
      }))
    : []);

  return [
    ...Object.entries(redirects).map(([source, target]) => ({
      params: { legacy: new URL(source).pathname.replace(/^\/+|\/+$/g, '') },
      props: { target },
    })),
    ...renamedPosts,
  ];
}

return Astro.redirect(sitePath(Astro.props.target), 301);
---
