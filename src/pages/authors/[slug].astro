---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAuthorInfo, getAuthorPic, getAuthorInitials } from '../../lib/authors';
import { buildTopicIndex, formatDate, getCoverImage, getExcerpt, postUrl } from '../../lib/archive';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.published !== false);
  const authors = [...new Set(posts.map(p => p.data.author))];
  return authors.map(author => ({
    params: { slug: author.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '') },
    props: { author },
  }));
}

const { author } = Astro.props;
const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
const authorPosts = allPosts
  .filter(p => p.data.author === author)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const authorInfo = getAuthorInfo(author);
const authorTopics = buildTopicIndex(authorPosts).slice(0, 8);
---

<BaseLayout title={`${author} — Posts`}>
  <div class="max-w-[728px] mx-auto px-4 pt-10 pb-20">
    <div class="flex items-start gap-5 mb-10">
      <img
        src={getAuthorPic(author)}
        alt={author}
        class="w-[72px] h-[72px] rounded-full object-cover bg-[#003388] flex-shrink-0"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
        loading="lazy"
      />
      <div class="w-[72px] h-[72px] rounded-full items-center justify-center text-white text-2xl font-bold flex-shrink-0 hidden" style="background: #003388;">
        {getAuthorInitials(author)}
      </div>
      <div class="pt-1">
        <h1 class="text-[28px] font-bold text-[#242424] dark:text-white font-sans">{author}</h1>
        <p class="text-[15px] text-[#6b6b6b] dark:text-[#999]">
          {authorPosts.length} {authorPosts.length === 1 ? 'post' : 'posts'}
        </p>
        {authorInfo?.bio && (
          <p class="text-[14px] text-[#6b6b6b] dark:text-[#999] mt-2 leading-relaxed max-w-[500px]">
            {authorInfo.bio}
          </p>
        )}
        <div class="flex flex-wrap gap-2 mt-4">
          {authorTopics.map((topic) => (
            <a href={`/topics/${topic.slug}`} class="inline-flex items-center gap-1.5 rounded-full bg-[#f2f2f2] dark:bg-[#242424] px-3 py-1 text-[12px] text-[#6b6b6b] dark:text-[#aaa] hover:bg-[#003388] hover:text-white transition-colors">
              <span>{topic.name}</span>
              <span class="opacity-70">{topic.count}</span>
            </a>
          ))}
        </div>
        <div class="flex flex-wrap gap-3 mt-4 text-[13px]">
          <a href={`/api/authors.json#${author.toLowerCase().replace(/\s+/g, '-')}`} class="text-[#1A8917] hover:underline">Archive data</a>
          <a href={`/search?q=${encodeURIComponent(author)}`} class="text-[#1A8917] hover:underline">Search this author</a>
        </div>
      </div>
    </div>

    <div class="divide-y divide-[#f2f2f2] dark:divide-[#333]">
      {authorPosts.map((post) => {
        const thumb = getCoverImage(post.body || '');
        return (
          <a href={postUrl(post)} class="group flex gap-5 py-6 first:pt-0 hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] -mx-4 px-4 transition-colors">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 text-[13px] text-[#6b6b6b] mb-1.5">
                <span>{formatDate(post.data.date)}</span>
              </div>
              <h2 class="text-[18px] md:text-[20px] font-bold leading-snug text-[#242424] dark:text-white group-hover:underline decoration-2 underline-offset-4 mb-1.5 line-clamp-2 font-sans">
                {post.data.title}
              </h2>
              <p class="text-[14px] text-[#6b6b6b] leading-relaxed line-clamp-2 hidden sm:block">
                {getExcerpt(post.body || '')}...
              </p>
            </div>
            {thumb ? (
              <img src={`/assets/${thumb}`} alt="" class="w-[112px] h-[112px] sm:w-[152px] sm:h-[152px] object-cover flex-shrink-0" loading="lazy" />
            ) : (
              <div class="w-[112px] h-[112px] sm:w-[152px] sm:h-[152px] flex-shrink-0 bg-[#f2f2f2] dark:bg-[#333] flex items-center justify-center">
                <span class="text-gray-300 dark:text-[#555] text-xs">eScience</span>
              </div>
            )}
          </a>
        );
      })}
    </div>

    <div class="mt-12 text-center">
      <a href="/" class="text-[14px] text-[#1A8917] hover:underline font-medium">← All posts</a>
    </div>
  </div>
</BaseLayout>
