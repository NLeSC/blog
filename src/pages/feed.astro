---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { comparePostsByDateDesc, formatDate, getExcerpt, isListedPost, postDate, postUrl } from '../lib/archive';
import { sitePath } from '../lib/urls';

const posts = (await getCollection('posts')).filter(isListedPost).sort(comparePostsByDateDesc);
---

<BaseLayout title="RSS feed" description="Subscribe to new eScience Center Blog posts with RSS.">
  <div class="max-w-[728px] mx-auto px-4 py-10 md:py-14">
    <section class="rounded-[24px] border border-[#f0d4c5] dark:border-[#543526] bg-[#fff8f3] dark:bg-[#211812] p-5 md:p-7 mb-10">
      <p class="text-[11px] uppercase tracking-[0.18em] text-[#f26522] font-semibold mb-2">RSS feed</p>
      <h1 class="text-[36px] md:text-[48px] font-bold tracking-[-0.045em] leading-none mb-4">Follow new posts</h1>
      <p class="text-[16px] text-[#6b6b6b] dark:text-[#aaa] leading-relaxed mb-5">Copy our feed URL into any RSS reader to receive new eScience Center Blog posts.</p>
      <code class="block rounded-lg bg-white dark:bg-[#29201a] border border-[#ead9cf] dark:border-[#604333] px-3 py-2 text-[13px] break-all mb-4">https://blog2.esciencecenter.nl/rss.xml</code>
      <a href={sitePath('/rss.xml')} class="inline-flex rounded-full bg-[#003388] px-4 py-2 text-[13px] font-semibold text-white hover:bg-[#002566] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#003388]">View raw XML</a>
    </section>

    <h2 class="text-[12px] uppercase tracking-[0.16em] text-[#777] dark:text-[#999] font-semibold mb-2">Latest posts</h2>
    <div class="divide-y divide-[#e8e8e8] dark:divide-[#333]">
      {posts.map(post => (
        <article class="py-6">
          <a href={postUrl(post)} class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#003388] rounded-lg">
            <h3 class="text-[21px] font-bold leading-snug tracking-[-0.025em] group-hover:text-[#003388] dark:group-hover:text-[#9ab5ff] transition-colors">{post.data.title}</h3>
            <p class="text-[13px] text-[#777] dark:text-[#999] mt-1">{formatDate(postDate(post), 'long')} · {post.data.author}</p>
            <p class="text-[14px] text-[#6b6b6b] dark:text-[#aaa] leading-relaxed mt-2">{getExcerpt(post.body || '', 180)}…</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
