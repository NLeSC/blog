---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = allPosts.slice(0, 60); // Show latest 60 on homepage, rest via pagination/search

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

function getCoverImage(body: string): string | null {
  const imgs = [...body.matchAll(/!\[.*?\]\(\/assets\/([^)]+)\)/g)];
  if (imgs.length === 0) return null;
  if (imgs.length >= 2 && imgs[0].index !== undefined && imgs[0].index < 300) {
    return imgs[1][1];
  }
  return imgs[0][1];
}

function getExcerpt(body: string, maxLen = 200): string {
  return body
    .replace(/!\[.*?\]\(\/assets\/[^)]+\)/g, '')
    .replace(/\(https?:\/\/[^)]+\)/g, '')
    .replace(/#{1,6}\s/g, '')
    .replace(/[_\*\[\]`]/g, '')
    .replace(/\s+/g, ' ')
    .slice(0, maxLen)
    .trim();
}

function authorSlug(name: string): string {
  return name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
}
---

<BaseLayout>
  <!-- Publication header banner -->
  <div class="max-w-[728px] mx-auto px-4 pt-8 pb-6">
    <img src="/header-banner.webp" alt="eScience Center Blog" class="w-full h-auto" />
  </div>

  <!-- Publication profile -->
  <div class="max-w-[728px] mx-auto px-4 pb-10">
    <div class="flex items-start gap-4">
      <div class="w-[64px] h-[64px] rounded-lg flex items-center justify-center flex-shrink-0" style="background: #FFC017;">
        <span class="text-[28px] font-bold text-white" style="font-family: Georgia, serif;">e</span>
      </div>
      <div class="flex-1 min-w-0 pt-0.5">
        <h2 class="text-[22px] font-bold text-[#242424] mb-0.5">Netherlands eScience Center</h2>
        <p class="text-[15px] text-[#6b6b6b] leading-relaxed mb-2">
          We are the Dutch national centre of expertise for research software.
        </p>
        <div class="flex items-center gap-2">
          <span class="text-[13px] text-[#6b6b6b]">
            <span class="font-medium text-[#242424]">{allPosts.length}</span> articles
          </span>
          <span class="text-[#6b6b6b]">·</span>
          <a href="/rss.xml" class="text-[13px] text-[#6b6b6b] hover:text-[#f26522] transition-colors">RSS</a>
          <span class="text-[#6b6b6b]">·</span>
          <a href="/search" class="text-[13px] text-[#6b6b6b] hover:text-[#242424] transition-colors">Search</a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-[728px] mx-auto px-4 pb-12">
    <!-- Featured post -->
    {(() => {
      const featured = posts[0];
      const featuredSlug = featured.id.replace(/\.md$/, '');
      const featuredCover = getCoverImage(featured.body || '');
      return (
        <a href={`/posts/${featuredSlug}`} class="group block mb-16">
          {featuredCover ? (
            <img src={`/assets/${featuredCover}`} alt="" class="w-full aspect-[2/1] object-cover mb-5" loading="eager" />
          ) : (
            <div class="w-full aspect-[2/1] mb-5 flex items-center justify-center bg-[#f2f2f2]">
              <span class="text-gray-300 text-lg">eScience Center</span>
            </div>
          )}
          <h1 class="text-[28px] md:text-[34px] font-bold leading-tight text-[#242424] group-hover:underline decoration-2 underline-offset-4 mb-2 font-sans">
            {featured.data.title}
          </h1>
          <p class="text-[15px] text-[#6b6b6b] leading-relaxed line-clamp-2 mb-3">
            {getExcerpt(featured.body || '', 280)}...
          </p>
          <div class="flex items-center gap-2 text-[13px] text-[#6b6b6b]">
            <span>{formatDate(featured.data.date)}</span>
            <span>·</span>
            <a href={`/authors/${authorSlug(featured.data.author)}`} class="hover:underline">{featured.data.author}</a>
          </div>
        </a>
      );
    })()}

    {/* 3-article grid — Medium-style row */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-12">
      {posts.slice(1, 4).map((post) => {
        const slug = post.id.replace(/\.md$/, '');
        const cover = getCoverImage(post.body || '');
        return (
          <a href={`/posts/${slug}`} class="group block">
            {cover ? (
              <img src={`/assets/${cover}`} alt="" class="w-full aspect-[16/10] object-cover mb-3" loading="lazy" />
            ) : (
              <div class="w-full aspect-[16/10] mb-3 bg-[#f2f2f2] flex items-center justify-center">
                <span class="text-gray-300 text-sm">eScience Center</span>
              </div>
            )}
            <div class="flex items-center gap-2 mb-2">
              <div class="w-5 h-5 rounded-full flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0" style="background: #003388;">
                {post.data.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase()}
              </div>
              <span class="text-[12px] text-[#6b6b6b]">{post.data.author}</span>
            </div>
            <h2 class="text-[16px] font-bold leading-snug text-[#242424] group-hover:underline decoration-2 underline-offset-4 mb-1 line-clamp-3 font-sans">
              {post.data.title}
            </h2>
            <p class="text-[13px] text-[#6b6b6b] leading-relaxed line-clamp-2 mb-2">
              {getExcerpt(post.body || '', 120)}...
            </p>
            <span class="text-[12px] text-[#6b6b6b]">{formatDate(post.data.date)}</span>
          </a>
        );
      })}
    </div>

    {/* Remaining posts — feed list */}
    <div class="divide-y divide-[#f2f2f2]">
      {posts.slice(4).map((post) => {
        const slug = post.id.replace(/\.md$/, '');
        const cover = getCoverImage(post.body || '');
        return (
          <a href={`/posts/${slug}`} class="group flex gap-5 py-6 first:pt-0 hover:bg-[#fafafa] -mx-4 px-4 transition-colors">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 text-[13px] text-[#6b6b6b] mb-1.5">
                <a href={`/authors/${authorSlug(post.data.author)}`} class="font-medium text-[#242424] hover:underline">{post.data.author}</a>
                <span>·</span>
                <span>{formatDate(post.data.date)}</span>
              </div>
              <h2 class="text-[18px] md:text-[20px] font-bold leading-snug text-[#242424] group-hover:underline decoration-2 underline-offset-4 mb-1.5 line-clamp-2 font-sans">
                {post.data.title}
              </h2>
              <p class="text-[14px] text-[#6b6b6b] leading-relaxed line-clamp-2 hidden sm:block">
                {getExcerpt(post.body || '')}...
              </p>
            </div>
            {cover ? (
              <img src={`/assets/${cover}`} alt="" class="w-[112px] h-[112px] sm:w-[152px] sm:h-[152px] object-cover flex-shrink-0" loading="lazy" />
            ) : (
              <div class="w-[112px] h-[112px] sm:w-[152px] sm:h-[152px] flex-shrink-0 bg-[#f2f2f2] flex items-center justify-center">
                <span class="text-gray-300 text-xs">eScience</span>
              </div>
            )}
          </a>
        );
      })}
    </div>

    <div class="mt-10 text-center text-[13px] text-[#6b6b6b]">
      Showing latest 60 of {allPosts.length} articles ·{' '}
      <a href="/search" class="hover:text-[#242424] underline">Search all posts</a>
    </div>
  </div>
</BaseLayout>
