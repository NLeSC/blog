---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildTopicIndex, formatDate, getCoverImage, getExcerpt, postUrl } from '../lib/archive';
import { assetPath, sitePath } from '../lib/urls';

const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = allPosts; // Show all posts on homepage
const topics = buildTopicIndex(allPosts).slice(0, 8);
---

<BaseLayout>
  <!-- Publication header banner -->
  <div class="max-w-[960px] mx-auto px-4 pt-8 pb-6 animate-enter">
    <img src={sitePath("/header-banner.webp")} alt="eScience Center Blog" class="w-full h-auto" />
  </div>

  <!-- Publication profile -->
  <div class="max-w-[960px] mx-auto px-4 pb-10 animate-enter" style="--enter-delay: 70ms">
    <div class="flex items-start gap-4">
      <div class="w-[64px] h-[64px] rounded-lg flex items-center justify-center flex-shrink-0" style="background: #FFC017;">
        <span class="text-[28px] font-bold text-white" style="font-family: Georgia, serif;">e</span>
      </div>
      <div class="flex-1 min-w-0 pt-0.5">
        <h2 class="text-[22px] font-bold text-[#242424] dark:text-white mb-0.5">Netherlands eScience Center</h2>
        <p class="text-[15px] text-[#6b6b6b] dark:text-[#999] leading-relaxed mb-2">
          We are the Dutch national centre of expertise for research software.
        </p>
        <div class="flex items-center gap-2">
          <span class="text-[13px] text-[#6b6b6b]">
            <span class="font-medium text-[#242424]">{allPosts.length}</span> articles
          </span>
          <span class="text-[#6b6b6b]">·</span>
          <a href={sitePath("/rss.xml")} class="text-[13px] text-[#6b6b6b] hover:text-[#f26522] transition-colors">RSS</a>
          <span class="text-[#6b6b6b]">·</span>
          <a href={sitePath("/search")} class="text-[13px] text-[#6b6b6b] hover:text-[#242424] transition-colors">Search</a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-[960px] mx-auto px-4 pb-12">
    <!-- Topic discovery — turns Medium tags into archive navigation -->
    <section class="mb-10 rounded-3xl animate-enter border border-[#e6e6e6] dark:border-[#333] bg-[#fafafa] dark:bg-[#151515] p-5 md:p-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-5">
        <div>
          <p class="text-[12px] uppercase tracking-[0.16em] text-[#6b6b6b] dark:text-[#999] mb-2">Knowledge map</p>
          <h2 class="text-[24px] md:text-[30px] font-bold leading-tight text-[#242424] dark:text-white font-sans">
            Browse the archive by topic
          </h2>
        </div>
        <a href={sitePath("/topics")} class="text-[14px] text-[#1A8917] hover:underline font-medium">All topics →</a>
      </div>
      <div class="flex flex-wrap gap-2">
        {topics.map((topic) => (
          <a href={sitePath(`/topics/${topic.slug}`)} class="inline-flex items-center gap-2 rounded-full bg-white dark:bg-[#222] border border-[#e6e6e6] dark:border-[#333] px-3 py-1.5 text-[13px] text-[#4a4a4a] dark:text-[#bbb] hover:border-[#003388] hover:text-[#003388] dark:hover:text-white transition-colors">
            <span>{topic.name}</span>
            <span class="text-[#999] dark:text-[#777]">{topic.count}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured post — side-by-side on desktop -->
    {(() => {
      const featured = posts[0];
      const featuredSlug = featured.id.replace(/\.md$/, '');
      const featuredCover = getCoverImage(featured.body || '');
      return (
        <a href={sitePath(`/posts/${featuredSlug}`)} class="group flex flex-col md:flex-row gap-4 md:gap-10 mb-10 md:mb-16 items-stretch md:items-start animate-enter" style="--enter-delay: 150ms">
          <div class="w-full md:w-1/2 flex-shrink-0">
            {featuredCover ? (
              <img src={assetPath(featuredCover)} alt="" class="w-full aspect-[16/10] md:aspect-[4/3] object-cover fade-in-image" loading="eager" />
            ) : (
              <div class="w-full aspect-[16/10] md:aspect-[4/3] flex items-center justify-center bg-[#f2f2f2] dark:bg-[#333]">
                <span class="text-gray-300 text-lg">eScience Center</span>
              </div>
            )}
          </div>
          <div class="w-full md:w-1/2">
            <h1 class="text-[26px] md:text-[30px] font-bold leading-tight text-[#242424] dark:text-white group-hover:underline decoration-2 underline-offset-4 mb-2 font-sans">
              {featured.data.title}
            </h1>
            <p class="text-[15px] text-[#6b6b6b] leading-relaxed line-clamp-4 md:line-clamp-3 mb-3">
              {getExcerpt(featured.body || '', 280)}...
            </p>
            <div class="flex items-center gap-2 text-[13px] text-[#6b6b6b]">
              <span>{formatDate(featured.data.date)}</span>
              <span>·</span>
              <span class="text-[#6b6b6b]">{featured.data.author}</span>
            </div>
          </div>
        </a>
      );
    })()}

    {/* 3-article grid — Medium-style row */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-12">
      {posts.slice(1, 4).map((post, index) => {
        const slug = post.id.replace(/\.md$/, '');
        const cover = getCoverImage(post.body || '');
        return (
          <a href={sitePath(`/posts/${slug}`)} class="group block animate-enter" style={`--enter-delay: ${210 + index * 55}ms`}>
            {cover ? (
              <img src={assetPath(cover)} alt="" class="w-full aspect-[16/10] object-cover mb-3 fade-in-image" loading="lazy" />
            ) : (
              <div class="w-full aspect-[16/10] mb-3 bg-[#f2f2f2] flex items-center justify-center">
                <span class="text-gray-300 text-sm">eScience Center</span>
              </div>
            )}
            <div class="flex items-center gap-2 mb-2">
              <div class="w-5 h-5 rounded-full flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0" style="background: #003388;">
                {post.data.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase()}
              </div>
              <span class="text-[12px] text-[#6b6b6b]">{post.data.author}</span>
            </div>
            <h2 class="text-[16px] font-bold leading-snug text-[#242424] dark:text-white group-hover:underline decoration-2 underline-offset-4 mb-1 line-clamp-3 font-sans">
              {post.data.title}
            </h2>
            <p class="text-[13px] text-[#6b6b6b] leading-relaxed line-clamp-2 mb-2">
              {getExcerpt(post.body || '', 120)}...
            </p>
            <span class="text-[12px] text-[#6b6b6b]">{formatDate(post.data.date)}</span>
          </a>
        );
      })}
    </div>

    {/* Remaining posts — feed list */}
    <div class="divide-y divide-[#f2f2f2]">
      {posts.slice(4).map((post, index) => {
        const slug = post.id.replace(/\.md$/, '');
        const cover = getCoverImage(post.body || '');
        return (
          <a href={sitePath(`/posts/${slug}`)} class="group flex gap-5 py-6 first:pt-0 hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] -mx-4 px-4 transition-colors animate-enter" style={`--enter-delay: ${Math.min(360 + index * 28, 720)}ms`}>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 text-[13px] text-[#6b6b6b] mb-1.5">
                <span class="font-medium text-[#242424] dark:text-white">{post.data.author}</span>
                <span>·</span>
                <span>{formatDate(post.data.date)}</span>
              </div>
              <h2 class="text-[18px] md:text-[20px] font-bold leading-snug text-[#242424] dark:text-white group-hover:underline decoration-2 underline-offset-4 mb-1.5 line-clamp-2 font-sans">
                {post.data.title}
              </h2>
              <p class="text-[14px] text-[#6b6b6b] leading-relaxed line-clamp-2 hidden sm:block">
                {getExcerpt(post.body || '')}...
              </p>
            </div>
            {cover ? (
              <img src={assetPath(cover)} alt="" class="w-[140px] h-[140px] sm:w-[200px] sm:h-[134px] object-cover flex-shrink-0 order-2 fade-in-image" loading="lazy" />
            ) : (
              <div class="w-[140px] h-[140px] sm:w-[200px] sm:h-[134px] flex-shrink-0 bg-[#f2f2f2] dark:bg-[#333] flex items-center justify-center order-2">
                <span class="text-gray-300 text-xs">eScience</span>
              </div>
            )}
          </a>
        );
      })}
    </div>

    <div class="mt-10 text-center text-[13px] text-[#6b6b6b] dark:text-[#999]">
      {allPosts.length} articles ·{' '}
      <a href={sitePath("/rss.xml")} class="hover:text-[#f26522] transition-colors">RSS</a>
      {' · '}
      <a href={sitePath("/search")} class="hover:text-[#242424] dark:hover:text-white underline">Search all posts</a>
    </div>
  </div>
</BaseLayout>
