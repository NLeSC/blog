---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthorInfo, getAuthorPic, getAuthorInitials } from '../../lib/authors';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function formatShortDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

function readTime(body: string): number {
  const words = body.replace(/<[^>]*>/g, '').split(/\s+/).length;
  return Math.max(1, Math.round(words / 225)); // 225 wpm average reading speed
}

const authorSlug = post.data.author.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
const authorInfo = getAuthorInfo(post.data.author);
const tags = post.data.tags || [];
const minutes = readTime(post.body || '');
const sourceSlug = post.id.replace(/\.md$/, '').split('/').pop() || post.id;

// Find related posts by same author
const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
const relatedPosts = allPosts
  .filter(p => p.data.author === post.data.author && p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function getThumb(body: string): string | null {
  const m = body.match(/!\[.*?\]\(\/assets\/([^)]+)\)/);
  return m ? m[1] : null;
}
---

<BaseLayout title={post.data.title}>
  <article class="max-w-[680px] mx-auto px-4">
    <header class="pt-10 pb-6">
      <h1 class="text-[32px] md:text-[40px] font-bold leading-tight text-[#242424] tracking-tight font-sans mb-6 dark:text-white">
        {post.data.title}
      </h1>

      <div class="flex items-start gap-4 mb-6">
        <a href={`/authors/${authorSlug}`} class="flex-shrink-0">
          <img
            src={getAuthorPic(post.data.author)}
            alt={post.data.author}
            class="w-12 h-12 rounded-full object-cover bg-[#003388]"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            loading="lazy"
          />
          <div class="w-12 h-12 rounded-full items-center justify-center text-white text-sm font-bold flex-shrink-0 hidden" style="background: #003388;">
            {getAuthorInitials(post.data.author)}
          </div>
        </a>
        <div class="flex flex-col gap-1 pt-0.5">
          <a href={`/authors/${authorSlug}`} class="font-medium text-[#242424] hover:underline dark:text-white">
            {post.data.author}
          </a>
          {authorInfo?.bio && (
            <p class="text-[13px] text-[#6b6b6b] leading-relaxed dark:text-[#999]">{authorInfo.bio}</p>
          )}
          <div class="flex items-center gap-1.5 text-[13px] text-[#6b6b6b] dark:text-[#999]">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span>·</span>
            <span>{minutes} min read</span>
            {post.data.source_url && (
              <>
                <span>·</span>
                <a href={post.data.source_url} target="_blank" rel="noopener" class="hover:text-[#242424] dark:hover:text-white transition-colors">
                  Originally on Medium
                </a>
              </>
            )}
          </div>
        </div>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.filter((t: string) => t !== 'uncategorized').map((tag: string) => (
            <a href={`/search?q=${encodeURIComponent(tag)}`} class="inline-block px-3 py-1 text-[12px] rounded-full bg-[#f2f2f2] text-[#6b6b6b] hover:bg-[#e6e6e6] hover:text-[#242424] transition-colors dark:bg-[#333] dark:text-[#aaa] dark:hover:bg-[#444] dark:hover:text-white">
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="post-content pb-12">
      <Content />
    </div>

    <!-- Suggest changes -->
    <div class="border-t border-[#f2f2f2] dark:border-[#333] pt-8 pb-12">
      <p class="text-[14px] text-[#6b6b6b] dark:text-[#999] leading-relaxed">
        Found a typo or want to suggest an improvement?
        {' '}
        <a
          href={`https://github.com/nlesc-blogging/blog/issues/new?title=Fix:%20${encodeURIComponent(post.data.title)}&body=Issue%20with%20post:%20/posts/${post.id.replace(/\.md$/, '')}%0A%0A**Suggested%20change:**%0A%0A`}
          target="_blank"
          rel="noopener"
          class="text-[#1A8917] hover:underline font-medium"
        >
          Suggest a change on GitHub →
        </a>
      </p>
    </div>

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <footer class="border-t border-[#f2f2f2] dark:border-[#333] pt-10 pb-16">
        <h2 class="text-[20px] font-bold text-[#242424] dark:text-white mb-6 font-sans">
          More from {post.data.author}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {relatedPosts.map(rp => {
            const rslug = rp.id.replace(/\.md$/, '');
            const thumb = getThumb(rp.body || '');
            return (
              <a href={`/posts/${rslug}`} class="group block">
                {thumb ? (
                  <img src={`/assets/${thumb}`} alt="" class="w-full aspect-[16/10] object-cover mb-3" loading="lazy" />
                ) : (
                  <div class="w-full aspect-[16/10] mb-3 bg-[#f2f2f2] dark:bg-[#333] flex items-center justify-center">
                    <span class="text-gray-300 dark:text-[#555] text-xs">eScience</span>
                  </div>
                )}
                <h3 class="text-[15px] font-semibold text-[#242424] dark:text-white leading-snug group-hover:underline decoration-2 underline-offset-3 line-clamp-2 mb-1 font-sans">
                  {rp.data.title}
                </h3>
                <span class="text-[13px] text-[#6b6b6b] dark:text-[#999]">{formatShortDate(rp.data.date)}</span>
              </a>
            );
          })}
        </div>
      </footer>
    )}
  </article>
</BaseLayout>
