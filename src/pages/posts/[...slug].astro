---
import { getCollection, render } from 'astro:content';
import CodePreviewTabs from '../../components/CodePreviewTabs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthorInfo, getAuthorPic, getAuthorInitials } from '../../lib/authors';
import { authorSlug, comparePostsByDateDesc, coverImageUrl, formatDate, formatDate as formatArchiveDate, getExcerpt, isListedPost, postDate, postSlug, postUrl, readTime, slugify, visibleTags } from '../../lib/archive';
import { repositoryPath, repositoryUrl, sitePath } from '../../lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const hasCodeExamples = post.body?.includes('data-code-example-preview');

const DEFAULT_LICENSE = {
  name: 'CC BY-SA 4.0',
  url: 'https://creativecommons.org/licenses/by-sa/4.0/',
  badgeUrl: 'https://creativecommons.org/wp-content/themes/vocabulary-theme/vocabulary/svg/cc/license_badges/big/by_sa.svg',
};

const frontmatterLicense = post.data.license;
const license = typeof frontmatterLicense === 'string'
  ? { name: frontmatterLicense }
  : (frontmatterLicense ?? DEFAULT_LICENSE);

const authorPathSlug = authorSlug(post.data.author);
const authorInfo = getAuthorInfo(post.data.author);
const authorPic = getAuthorPic(post.data.author);
const tags = visibleTags(post.data.tags || []);
const minutes = readTime(post.body || '');
const date = postDate(post);
const excerpt = getExcerpt(post.body || '', 220);
const cover = coverImageUrl(post);
const postSourcePath = post.filePath?.replace(/^.*?(content\/posts\/)/, '$1')
  || `content/posts/${post.id.endsWith('.md') ? post.id : `${post.id}/index.md`}`;
const postEditUrl = repositoryPath(`edit/main/${postSourcePath}`);

// Find related posts by shared topics first, then same author
const allPosts = (await getCollection('posts')).filter(isListedPost);
const tagSet = new Set(tags.map((tag: string) => slugify(tag)));
const relatedPosts = allPosts
  .filter(p => p.id !== post.id)
  .map((candidate) => {
    const sharedTopics = visibleTags(candidate.data.tags || []).filter((tag) => tagSet.has(slugify(tag))).length;
    const sameAuthor = candidate.data.author === post.data.author ? 1 : 0;
    return { post: candidate, score: sharedTopics * 4 + sameAuthor };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || comparePostsByDateDesc(a.post, b.post))
  .slice(0, 3)
  .map(({ post }) => post);
---

<BaseLayout title={post.data.title} description={excerpt} ogImage={cover} author={post.data.author} noindex={post.data.unlisted}>
  <article class="max-w-[720px] mx-auto px-4 animate-page">
    <header class="pt-10 md:pt-12 pb-8 animate-enter">
      <h1 class="text-[34px] md:text-[46px] font-bold leading-[1.08] text-[#242424] tracking-[-0.045em] font-sans mb-7 dark:text-white">
        {post.data.title}
      </h1>

      <div class="flex items-start gap-4 mb-6">
        <a href={sitePath(`/authors/${authorPathSlug}`)} class="flex-shrink-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#003388] rounded-full">
          {authorPic ? (
            <img
              src={authorPic}
              alt={post.data.author}
              class="w-12 h-12 rounded-full object-cover bg-[#003388] fade-in-image"
              loading="lazy"
            />
          ) : (
            <div class="w-12 h-12 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background: #003388;">
              {getAuthorInitials(post.data.author)}
            </div>
          )}
        </a>
        <div class="flex flex-col gap-1 pt-0.5">
          <a href={sitePath(`/authors/${authorPathSlug}`)} class="font-medium text-[#242424] hover:text-[#003388] dark:text-white dark:hover:text-[#9ab5ff] transition-colors">
            {post.data.author}
          </a>
          {authorInfo?.bio && (
            <p class="text-[13px] text-[#6b6b6b] leading-relaxed dark:text-[#999]">{authorInfo.bio}</p>
          )}
          <div class="flex items-center gap-1.5 text-[13px] text-[#6b6b6b] dark:text-[#999]">
            <time datetime={date.toISOString()}>{formatDate(date, 'long')}</time>
            <span>·</span>
            <span>{minutes} min read</span>
            {post.data.source_url && (
              <>
                <span>·</span>
                <a href={post.data.source_url} target="_blank" rel="noopener" class="hover:text-[#242424] dark:hover:text-white transition-colors">
                  Originally on Medium
                </a>
              </>
            )}
          </div>
        </div>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <a href={sitePath(`/topics/${slugify(tag)}`)} class="inline-flex rounded-full border border-[#e6e6e6] dark:border-[#333] bg-[#f7f7f7] dark:bg-[#202020] px-3 py-1.5 text-[12px] text-[#6b6b6b] dark:text-[#aaa] hover:border-[#003388] hover:text-[#003388] dark:hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#003388] transition-colors">
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="post-content pb-8 animate-enter" style="--enter-delay: 120ms">
      <Content />
      {hasCodeExamples && <CodePreviewTabs />}
    </div>

    <!-- License -->
    <section class="border-t border-[#f2f2f2] dark:border-[#333] pt-8 pb-8" aria-labelledby="post-license-heading">
      <h2 id="post-license-heading" class="sr-only">Post license</h2>
      <p class="text-[14px] text-[#6b6b6b] dark:text-[#999] leading-relaxed mb-3">
        Unless otherwise stated, this post is licensed under{' '}
        {license.url ? (
          <a href={license.url} target="_blank" rel="license noopener" class="text-[#1A8917] hover:underline font-medium">
            {license.name}
          </a>
        ) : (
          <span class="font-medium text-[#242424] dark:text-white">{license.name}</span>
        )}.
      </p>
      {license.badgeUrl && (
        license.url ? (
          <a href={license.url} target="_blank" rel="license noopener" class="inline-block">
            <img src={license.badgeUrl} alt={`${license.name} license badge`} class="h-8 w-auto" loading="lazy" />
          </a>
        ) : (
          <img src={license.badgeUrl} alt={`${license.name} license badge`} class="h-8 w-auto" loading="lazy" />
        )
      )}
    </section>

    <!-- Suggest changes -->
    <div class="border-t border-[#f2f2f2] dark:border-[#333] pt-8 pb-12">
      <p class="text-[14px] text-[#6b6b6b] dark:text-[#999] leading-relaxed">
        Improve this post:
        {' '}
        <a
          href={`${repositoryUrl}/issues/new?title=Fix:%20${encodeURIComponent(post.data.title)}&body=Issue%20with%20post:%20/posts/${postSlug(post)}%0A%0A**Suggested%20change:**%0A%0A`}
          target="_blank"
          rel="noopener"
          class="text-[#1A8917] hover:underline font-medium"
        >
          suggest a change
        </a>
        {' '}
        <span aria-hidden="true">·</span>
        {' '}
        <a
          href={postEditUrl}
          target="_blank"
          rel="noopener"
          class="text-[#1A8917] hover:underline font-medium"
        >
          edit source
        </a>
      </p>
    </div>

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <footer class="border-t border-[#f2f2f2] dark:border-[#333] pt-10 pb-16">
        <h2 class="text-[20px] font-bold text-[#242424] dark:text-white mb-6 font-sans">
          Related posts
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 md:gap-6">
          {relatedPosts.map(rp => {
            const thumb = coverImageUrl(rp);
            return (
              <a href={postUrl(rp)} class="group block rounded-[22px] p-2 -m-2 hover:bg-[#fafafa] dark:hover:bg-[#181818] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#003388] transition-colors">
                {thumb ? (
                  <img src={thumb} alt="" class="w-full aspect-[16/10] object-cover rounded-[18px] mb-3 fade-in-image" loading="lazy" />
                ) : (
                  <div class="w-full aspect-[16/10] mb-3 rounded-[18px] bg-[#f2f2f2] dark:bg-[#333] flex items-center justify-center">
                    <span class="text-gray-300 dark:text-[#555] text-xs">eScience</span>
                  </div>
                )}
                <h3 class="text-[15px] font-semibold text-[#242424] dark:text-white leading-snug group-hover:text-[#003388] dark:group-hover:text-[#9ab5ff] line-clamp-2 mb-1 font-sans transition-colors">
                  {rp.data.title}
                </h3>
                  <span class="text-[13px] text-[#6b6b6b] dark:text-[#999]">{formatArchiveDate(postDate(rp))}</span>
              </a>
            );
          })}
        </div>
      </footer>
    )}
  </article>
</BaseLayout>
