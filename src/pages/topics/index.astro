---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildTopicIndex, formatDate } from '../../lib/archive';

const posts = await getCollection('posts', ({ data }) => data.published !== false);
const topics = buildTopicIndex(posts);
const featuredTopics = topics.slice(0, 24);
---

<BaseLayout title="Topics" description="Browse the eScience Center Blog by topic, technology, and research software theme.">
  <section class="max-w-[960px] mx-auto px-4 pt-10 pb-16">
    <div class="max-w-[680px] mb-10">
      <p class="text-[13px] uppercase tracking-[0.16em] text-[#6b6b6b] dark:text-[#999] mb-3">Archive navigation</p>
      <h1 class="text-[34px] md:text-[48px] font-bold leading-tight tracking-tight text-[#242424] dark:text-white font-sans mb-4">
        Explore by topic
      </h1>
      <p class="text-[17px] leading-relaxed text-[#6b6b6b] dark:text-[#aaa]">
        Medium gave the blog tags. Owning the archive lets those tags become a real knowledge map for research software, AI, HPC, FAIR, reproducibility, and scientific domains.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
      {featuredTopics.map((topic) => (
        <a href={`/topics/${topic.slug}`} class="group block rounded-2xl border border-[#e6e6e6] dark:border-[#333] p-5 hover:border-[#003388] dark:hover:border-[#4f7cff] hover:shadow-sm transition-all bg-white dark:bg-[#151515]">
          <div class="flex items-start justify-between gap-4 mb-6">
            <h2 class="text-[20px] font-bold leading-tight text-[#242424] dark:text-white group-hover:underline decoration-2 underline-offset-4 font-sans">
              {topic.name}
            </h2>
            <span class="text-[12px] rounded-full px-2 py-1 bg-[#f2f2f2] dark:bg-[#242424] text-[#6b6b6b] dark:text-[#aaa] flex-shrink-0">
              {topic.count}
            </span>
          </div>
          <p class="text-[13px] text-[#6b6b6b] dark:text-[#999]">
            Latest: {formatDate(topic.latest)}
          </p>
        </a>
      ))}
    </div>

    <section class="border-t border-[#f2f2f2] dark:border-[#333] pt-8">
      <h2 class="text-[22px] font-bold text-[#242424] dark:text-white font-sans mb-4">All topics</h2>
      <div class="flex flex-wrap gap-2">
        {topics.map((topic) => (
          <a href={`/topics/${topic.slug}`} class="inline-flex items-center gap-2 rounded-full bg-[#f7f7f7] dark:bg-[#1f1f1f] px-3 py-1.5 text-[13px] text-[#4a4a4a] dark:text-[#bbb] hover:bg-[#003388] hover:text-white dark:hover:bg-[#003388] transition-colors">
            <span>{topic.name}</span>
            <span class="opacity-70">{topic.count}</span>
          </a>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
